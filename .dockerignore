# =============================================================================
# Docker Ignore File for Sub2API
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!deploy/DOCKER.md
!third_party/infinite-canvas/CHANGELOG.md
# Keep the docs directory traversable so the legal markdown imported by the
# Vue build can be re-included without copying the rest of docs/ into Docker.
docs/*
# admin-compliance gate (LegalDocumentView.vue) build-time imports
# docs/legal/*.md?raw into the frontend bundle; keep that subtree in the
# Docker build context even though docs/ is otherwise excluded.
!docs/legal/
!docs/legal/*.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
backend/internal/web/dist/

# Node modules (will be installed in container)
frontend/node_modules/
third_party/infinite-canvas/web/node_modules/
node_modules/

# Go build cache (will be built in container)
backend/vendor/

# Test files
*_test.go
**/*.test.js
coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example

# 本地闭源插件目录可能包含发布签名私钥，绝不能进入 Docker 构建上下文。
/plugins/

# Local config
config.yaml
config.local.yaml

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
/.tmp-codex/
/.tmp-go-cache/
/.tmp-ui/
/backend/.tmp/
/backend/.gocache/
/backend/.gomodcache/
/backend/.gopath/
/backend/.tmp-go-cache*/
/.tmp-email-gocache/
/backend/.tmp-email-gocache/
frontend/.canvas-*

# Local build caches and generated binaries (never needed in the runtime image)
**/.gocache*/
**/.gomodcache*/
**/.gopath*/
**/.tmp-go-cache*/
**/.tmp-email-gocache*/
/.corepack/
/backend/backend/
/backend/server.exe

# Deploy files (not needed in image)
deploy/install.sh
deploy/sub2api.service
deploy/sub2api-sudoers
deploy/data/
deploy/postgres_data/
deploy/redis_data/
deploy/workbench-local/data/
deploy/workbench-local/backups/

# GoReleaser
.goreleaser.yaml

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md
